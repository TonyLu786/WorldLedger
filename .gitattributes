* text=auto

.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
go.mod text eol=lf
go.sum text eol=lf
LICENSE text eol=lf
NOTICE text eol=lf
*.go text eol=lf
*.java text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Makefile text eol=lf
gradlew text eol=lf
*.sh text eol=lf
*.html text eol=lf
# The desktop application's page is compiled into its binary, so a checkout that
# translated these to CRLF would produce a different binary from one that did
# not. A published checksum that depends on which platform did the build is not
# a checksum.
*.css text eol=lf
*.js text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

*.bin binary
*.jar binary

# Objects in a committed archive are addressed by the digest of their own bytes
# and carry no extension, so `text=auto` above would take them for text. A
# checkout that translated a line ending in one would change the digest the path
# is named after, and the archive would fail its own integrity check on one
# platform and pass on another.
testdata/**/objects/sha256/** binary

# Golden vectors generated by a real JVM and compared line by line. Line-ending
# translation would alter them silently, and the failure would surface as a
# canonical-encoding mismatch rather than as a checkout problem.
internal/seed/testdata/*.txt text eol=lf
